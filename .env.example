# Database
POSTGRES_DB=okdriver
POSTGRES_USER=okdriver
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://okdriver:change-me@localhost:5432/okdriver

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
RUN_SEED=false

# Local seed command (set real values in .env or the shell; never commit them)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=
SEED_WATCHLIST_IDENTIFIER=KA01AB1234

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Camera simulator
SIMULATOR_API_URL=http://localhost:8000
SIMULATOR_TOKEN=
SIMULATOR_USERNAME=operator
SIMULATOR_PASSWORD=change-me
SIMULATOR_DETECTION_SECONDS=5
SIMULATOR_HEARTBEAT_SECONDS=10
SIMULATOR_WATCHLIST_IDENTIFIERS=KA01AB1234
SIMULATOR_DRY_RUN=false
